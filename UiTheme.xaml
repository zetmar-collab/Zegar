<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="UiBackground" Color="#F3F6FA" />
  <SolidColorBrush x:Key="UiSurface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="UiText" Color="#18283F" />
  <SolidColorBrush x:Key="UiMuted" Color="#52647A" />
  <SolidColorBrush x:Key="UiBorder" Color="#DCE3ED" />
  <SolidColorBrush x:Key="UiInputBorder" Color="#7A8BA2" />
  <SolidColorBrush x:Key="UiAccent" Color="#2459AA" />
  <SolidColorBrush x:Key="UiAccentHover" Color="#1C4789" />
  <SolidColorBrush x:Key="UiSoft" Color="#EAF1FC" />
  <SolidColorBrush x:Key="UiHover" Color="#DDE8F8" />
  <SolidColorBrush x:Key="UiOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="UiDanger" Color="#AD291F" />
  <SolidColorBrush x:Key="UiFocus" Color="#2459AA" />
  <Style x:Key="UiFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource UiFocus}" BorderThickness="2" CornerRadius="9" Margin="-3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="15,8" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Background" Value="{DynamicResource UiSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiInputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource UiHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource UiAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource UiOnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource UiAccentHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource UiSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
    <Setter Property="CaretBrush" Value="{DynamicResource UiText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiInputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource UiFocus}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource UiSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiInputBorder}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TabPanel IsItemsHost="True" Margin="0,0,0,18" KeyboardNavigation.TabIndex="1" />
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Margin" Value="0,3,8,3" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource UiMuted}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="{DynamicResource UiSoft}" />
              <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource UiAccent}" />
              <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="{DynamicResource UiHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style x:Key="FormError" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiDanger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SurfaceCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource UiSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
</ResourceDictionary>