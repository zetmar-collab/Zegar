<Application x:Class="Zegar.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#EAF0FA"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#E8EDF4"/><Setter Property="Foreground" Value="#172337"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Application.Resources>
</Application>
