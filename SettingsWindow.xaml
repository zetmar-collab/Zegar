<Window x:Class="Zegar.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="pack://application:,,,/Zegar;component/assets/Zegar.ico" Title="Ustawienia zegara" Width="720" Height="820" MinWidth="620" MinHeight="580" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="UiTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="ZEGAR HTC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}" />
      <TextBlock Text="Twój zegar" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,4" />
      <TextBlock Text="Miejsce, wygląd i uruchamianie" Foreground="{DynamicResource UiMuted}" />
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" AutomationProperties.Name="Kategorie ustawień">
      <TabItem Header="Zegar">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2,2,12,4">
            <Border Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <TextBlock Text="Czas i układ" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Język / Language" Margin="0,0,0,8" />
                    <ComboBox x:Name="LanguageInput" Padding="7" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language / Język">
                      <ComboBoxItem Content="Polski" Tag="pl" />
                      <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Format zegara" Margin="0,0,0,8" />
                    <ComboBox x:Name="ClockFormatInput" Padding="7" SelectionChanged="ClockFormatChanged" AutomationProperties.Name="Format zegara">
                      <ComboBoxItem Content="24H" />
                      <ComboBoxItem Content="12H (AM/PM)" />
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="CompactInput" Content="Tryb kompaktowy" Margin="0,0,0,16" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <TextBlock Text="Zachowanie widżetu" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="StartupInput" Content="Uruchamiaj razem z systemem Windows" Margin="0,0,0,12" />
                <CheckBox x:Name="TopmostInput" Content="Zawsze na wierzchu" Margin="0,0,0,12" />
                <CheckBox x:Name="LockInput" Content="Zablokuj położenie widżetu" Margin="0,0,0,14" />
                <TextBlock Text="Data i godzina zgodnie z ustawieniami Windows." FontSize="12" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Pogoda">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2,2,12,4">
            <Border Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <TextBlock Text="Wyszukaj miejscowość" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <DockPanel>
                  <Button x:Name="SearchButton" Content="Szukaj" Click="Search" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox x:Name="CityInput" Padding="9" VerticalContentAlignment="Center" KeyDown="CityKeyDown" TextChanged="CityChanged" AutomationProperties.Name="Nazwa miejscowości" />
                </DockPanel>
                <ListBox x:Name="Places" Height="98" Margin="0,8,0,0" BorderBrush="{DynamicResource UiInputBorder}" Padding="4" SelectionChanged="PlaceSelected" AutomationProperties.Name="Wyniki wyszukiwania miejscowości" />
                <TextBlock x:Name="SearchStatus" Text="Wpisz nazwę i wybierz miejscowość z listy." Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,6,0,18" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <TextBlock Text="Ulubione miejscowości" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ComboBox x:Name="FavoritesInput" AutomationProperties.Name="Ulubione miejscowości" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,18">
                  <Button Content="Wybierz" Click="UseFavorite" />
                  <Button Content="Dodaj wybraną" Click="AddFavorite" />
                  <Button Content="Usuń ulubioną" Click="RemoveFavorite" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <TextBlock Text="Jednostki i odświeżanie" Style="{StaticResource SectionTitle}" />
                <WrapPanel Margin="0,0,0,18">
                  <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Temperatura" Margin="0,0,0,6" />
                    <ComboBox x:Name="TemperatureInput" Width="125" AutomationProperties.Name="Temperatura">
                      <ComboBoxItem Content="°C" />
                      <ComboBoxItem Content="°F" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Prędkość wiatru" Margin="0,0,0,6" />
                    <ComboBox x:Name="WindInput" Width="125" AutomationProperties.Name="Prędkość wiatru">
                      <ComboBoxItem Content="km/h" />
                      <ComboBoxItem Content="m/s" />
                      <ComboBoxItem Content="mph" />
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>
                <DockPanel Margin="0,0,0,20">
                  <TextBlock Text="Odświeżaj pogodę co" VerticalAlignment="Center" />
                  <ComboBox x:Name="IntervalInput" Width="105" HorizontalAlignment="Right" Padding="5" AutomationProperties.Name="Częstotliwość odświeżania" />
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Wygląd">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2,2,12,4">
            <Border Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <TextBlock Text="Podgląd" Style="{StaticResource SectionTitle}" />
                <Border x:Name="FontPreviewBackground" Padding="16" CornerRadius="8" Margin="0,0,0,20">
                  <TextBlock x:Name="FontPreview" Text="12:34 · Poniedziałek · 21°C" FontSize="20" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Kolor widżetu" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                  <Border x:Name="ColorSwatch" Width="33" Height="33" CornerRadius="6" BorderThickness="1" BorderBrush="#94A3B8" Margin="0,0,10,0" />
                  <Button Content="Wybierz kolor…" Click="ChooseColor" />
                  <Button Content="Domyślny" Click="ResetColor" />
                </StackPanel>
                <TextBlock Text="Czcionka widżetu" Margin="0,0,0,8" />
                <ComboBox x:Name="FontInput" Padding="7" MaxDropDownHeight="250" Margin="0,0,0,14" SelectionChanged="FontChanged" AutomationProperties.Name="Krój czcionki widżetu">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Kolor czcionki (cyfry, data i pogoda)" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border x:Name="FontColorSwatch" Width="33" Height="33" CornerRadius="6" BorderThickness="1" BorderBrush="#94A3B8" Margin="0,0,10,0" />
                  <Button Content="Kolor czcionki…" Click="ChooseFontColor" />
                  <Button Content="Automatyczny" Click="ResetFontColor" />
                </StackPanel>
                <Grid>
                  <TextBlock Text="Rozmiar widżetu" />
                  <TextBlock x:Name="ScaleLabel" HorizontalAlignment="Right" Foreground="{DynamicResource UiMuted}" />
                </Grid>
                <Slider x:Name="ScaleInput" Minimum="65" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ScaleChanged" Margin="0,10,0,17" AutomationProperties.Name="Rozmiar widżetu w procentach" />
                <TextBlock x:Name="ContrastLabel" Foreground="{DynamicResource UiDanger}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Grid>
                  <TextBlock Text="Przezroczystość tła" />
                  <TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" Foreground="{DynamicResource UiMuted}" />
                </Grid>
                <Slider x:Name="OpacityInput" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" Margin="0,10,0,17" AutomationProperties.Name="Widoczność widżetu w procentach" />
                <Grid>
                  <TextBlock Text="Widoczność tekstu" />
                  <TextBlock x:Name="TextOpacityLabel" HorizontalAlignment="Right" Foreground="{DynamicResource UiMuted}" />
                </Grid>
                <Slider x:Name="TextOpacityInput" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="TextOpacityChanged" Margin="0,10,0,17" AutomationProperties.Name="Widoczność tekstu" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCard}">
              <StackPanel>
                <Expander Header="Profile wyglądu" Padding="0,4">
                  <StackPanel Margin="0,16,0,0">
                    <ComboBox x:Name="ProfilesInput" AutomationProperties.Name="Profile wyglądu" Margin="0,0,0,8" />
                    <TextBlock Text="Nazwa profilu" Margin="0,0,0,6" />
                    <TextBox x:Name="ProfileNameInput" MaxLength="60" AutomationProperties.Name="Nazwa profilu" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,18">
                      <Button Content="Zastosuj profil" Click="UseProfile" />
                      <Button Content="Zapisz profil" Click="SaveProfile" />
                      <Button Content="Usuń profil" Click="RemoveProfile" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock x:Name="RecoveryLabel" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" />
        <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource UiDanger}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel LastChildFill="True">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="Anuluj" IsCancel="True" Click="Cancel" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Zapisz ustawienia" Style="{StaticResource PrimaryButton}" Margin="0" Click="Save" />
          </StackPanel>
          <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource UiMuted}" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>