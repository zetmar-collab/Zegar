<Window x:Class="Zegar.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ustawienia zegara" Width="610" Height="800" MinWidth="540" MinHeight="540" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterScreen" Background="#F6F8FC" Foreground="#172337" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
 <Grid Margin="28,23">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Twój zegar" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Miejsce, wygląd i uruchamianie" Foreground="#64748B" Margin="0,4,0,20"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <TextBlock Text="POGODA DLA MIEJSCOWOŚCI" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
   <DockPanel>
    <Button x:Name="SearchButton" Content="Szukaj" Click="Search" DockPanel.Dock="Right" Margin="8,0,0,0"/>
    <TextBox x:Name="CityInput" Padding="9" VerticalContentAlignment="Center" KeyDown="CityKeyDown" TextChanged="CityChanged" AutomationProperties.Name="Nazwa miejscowości"/>
   </DockPanel>
   <ListBox x:Name="Places" Height="98" Margin="0,8,0,0" BorderBrush="#DCE3ED" Padding="4" SelectionChanged="PlaceSelected" AutomationProperties.Name="Wyniki wyszukiwania miejscowości"/>
   <TextBlock x:Name="SearchStatus" Text="Wpisz nazwę i wybierz miejscowość z listy." Foreground="#64748B" FontSize="11" Margin="0,6,0,18" TextWrapping="Wrap"/>
   <TextBlock Text="Kolor widżetu" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
    <Border x:Name="ColorSwatch" Width="33" Height="33" CornerRadius="6" BorderThickness="1" BorderBrush="#94A3B8" Margin="0,0,10,0"/>
    <Button Content="Wybierz kolor…" Click="ChooseColor"/>
    <Button Content="Domyślny" Click="ResetColor"/>
   </StackPanel>
   <TextBlock Text="Czcionka widżetu" Margin="0,0,0,8"/>
   <ComboBox x:Name="FontInput" Padding="7" MaxDropDownHeight="250" Margin="0,0,0,14" SelectionChanged="FontChanged" AutomationProperties.Name="Krój czcionki widżetu">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <TextBlock Text="Kolor czcionki (cyfry, data i pogoda)" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
    <Border x:Name="FontColorSwatch" Width="33" Height="33" CornerRadius="6" BorderThickness="1" BorderBrush="#94A3B8" Margin="0,0,10,0"/>
    <Button Content="Kolor czcionki…" Click="ChooseFontColor"/>
    <Button Content="Automatyczny" Click="ResetFontColor"/>
   </StackPanel>
   <Border x:Name="FontPreviewBackground" Padding="16" CornerRadius="8" Margin="0,0,0,20">
    <TextBlock x:Name="FontPreview" Text="12:34 · Poniedziałek · 21°C" FontSize="20" TextWrapping="Wrap"/>
   </Border>
   <Grid><TextBlock Text="Rozmiar widżetu"/><TextBlock x:Name="ScaleLabel" HorizontalAlignment="Right" Foreground="#64748B"/></Grid>
   <Slider x:Name="ScaleInput" Minimum="65" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ScaleChanged" Margin="0,10,0,17" AutomationProperties.Name="Rozmiar widżetu w procentach"/>
   <Grid><TextBlock Text="Przezroczystość"/><TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" Foreground="#64748B"/></Grid>
   <Slider x:Name="OpacityInput" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" Margin="0,10,0,17" AutomationProperties.Name="Widoczność widżetu w procentach"/>
   <DockPanel Margin="0,0,0,20"><TextBlock Text="Odświeżaj pogodę co" VerticalAlignment="Center"/><ComboBox x:Name="IntervalInput" Width="105" HorizontalAlignment="Right" Padding="5" AutomationProperties.Name="Częstotliwość odświeżania"/></DockPanel>
   <CheckBox x:Name="StartupInput" Content="Uruchamiaj razem z systemem Windows" Margin="0,0,0,12"/>
   <CheckBox x:Name="TopmostInput" Content="Zawsze na wierzchu" Margin="0,0,0,12"/>
   <CheckBox x:Name="LockInput" Content="Zablokuj położenie widżetu" Margin="0,0,0,14"/>
   <TextBlock Text="Czas i data: zgodnie z zegarem systemowym.&#x0a;Pogoda: Open-Meteo, °C. Nie wymaga klucza API." FontSize="11" Foreground="#64748B"/>
  </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="SaveStatus" Foreground="#AE3131" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Anuluj" IsCancel="True" Click="Cancel"/><Button x:Name="SaveButton" Content="Zapisz ustawienia" Background="#244A6E" Foreground="White" Margin="0" Click="Save"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
